<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the PyInstaller folder (dist/ViperIDE) as a GitHub artifact zip.
     Signs Viper's own exe; the bundled third-party DLLs and .pyd files keep their upstream signatures. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="ViperIDE.exe" product-name="Viper IDE">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
